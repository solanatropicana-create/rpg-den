<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Combat port check (C# side): rebuilds every case of golden/ts/combat_check.ts from its `spec` through the real
    Combat.Unit / Monsters.MonsterSide / Combat.HeroCombatant + Combat.ResolveBattle and prints { k, out } per line.
    Compiles FD.Macro sources directly (Core without Sim.cs, Data, Js, WorldGen, Combat, Monsters) with CombatStubs.cs
    standing in for Sim / Sea (MonsterSide never touches them), so it works while other modules are mid-edit and never
    races other builds for FD.Macro/obj. Same language/globalization settings as FD.Macro.
    Run from macro/ (see the header of golden/ts/combat_check.ts):
      node golden/ts/build.mjs combat_check && node golden/out/combat_check.js 5000 20260930 > /tmp/combat_ts.ndjson
      dotnet build tests/CombatCheck -c Release && dotnet tests/CombatCheck/bin/Release/net8.0/CombatCheck.dll /tmp/combat_ts.ndjson > /tmp/combat_cs.ndjson
      python3 tests/CombatCheck/combat_compare.py /tmp/combat_ts.ndjson /tmp/combat_cs.ndjson
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CombatCheck</RootNamespace>
    <AssemblyName>CombatCheck</AssemblyName>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS1591;CS0162;CS0168;CS0219</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="CombatStubs.cs" />
    <Compile Include="../../FD.Macro/Core/*.cs" Exclude="../../FD.Macro/Core/Sim.cs;../../FD.Macro/Core/Save.cs;../../FD.Macro/Core/Stats.cs" />
    <Compile Include="../../FD.Macro/Data/*.cs" />
    <Compile Include="../../FD.Macro/Js/*.cs" />
    <Compile Include="../../FD.Macro/Modules/WorldGen.cs" />
    <Compile Include="../../FD.Macro/Modules/Combat.cs" />
    <Compile Include="../../FD.Macro/Modules/Monsters.cs" />
    <EmbeddedResource Include="../../FD.Macro/Data/data.json" LogicalName="FD.Macro.Data.data.json" />
  </ItemGroup>
</Project>
