<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Sea port check (C# side): replays every line of golden/ts/sea_check.ts. 'q' lines (queries) run in order on one
    Sim.FromWorld(snapshot) per snapshot (same caches as TS); 'case' lines each run one Sea entry point on a fresh
    Sim.FromWorld(snapshot). Compiles all FD.Macro sources directly (own obj dir, so it never races other builds for
    FD.Macro/obj). Run from macro/ (see the header of golden/ts/sea_check.ts):
      node golden/ts/build.mjs sea_check && node golden/out/sea_check.js 1 0,1500,3000 3500 > /tmp/sea_ts.ndjson
      dotnet build tests/SeaCheck -c Release && dotnet tests/SeaCheck/bin/Release/net8.0/SeaCheck.dll /tmp/sea_ts.ndjson > /tmp/sea_cs.ndjson
      python3 tests/SeaCheck/sea_compare.py /tmp/sea_ts.ndjson /tmp/sea_cs.ndjson
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SeaCheck</RootNamespace>
    <AssemblyName>SeaCheck</AssemblyName>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS1591;CS0162;CS0168;CS0219</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../FD.Macro/Core/*.cs" />
    <Compile Include="../../FD.Macro/Data/*.cs" />
    <Compile Include="../../FD.Macro/Js/*.cs" />
    <Compile Include="../../FD.Macro/Modules/*.cs" />
    <EmbeddedResource Include="../../FD.Macro/Data/data.json" LogicalName="FD.Macro.Data.data.json" />
  </ItemGroup>
</Project>
