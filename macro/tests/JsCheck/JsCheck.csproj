<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bit-exact checks of FD.Macro's JS-semantics layer (JsMath / JsSort) against Node 22 vectors. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>JsCheck</RootNamespace>
    <AssemblyName>JsCheck</AssemblyName>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../FD.Macro/FD.Macro.csproj" />
  </ItemGroup>
</Project>
