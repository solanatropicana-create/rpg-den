+            cause: $"{tides}d20 = {J.S(roll)}: {(roll <= 9 ? "Kan Soyu: büyünün bedeli" : roll <= 11 ? "Kan Soyu: büyü tuhaf bir iz bıraktı" : "Kan Soyu: şans bu kez yüzlerine güldü")}");
     }
 }
