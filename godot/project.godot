; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fantastik Dünya"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

App="*res://src/core/App.cs"
Dev="*res://src/dev/Dev.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode.release=3

[dotnet]

project/assembly_name="FantastikDunya"

[layer_names]

3d_physics/layer_1="terrain"
3d_physics/layer_2="props"
3d_physics/layer_3="player"
3d_physics/layer_4="actors"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

reflections/sky_reflections/roughness_layers=6
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.55, 0.65, 0.75, 1)
lights_and_shadows/positional_shadow/atlas_size=2048

[shader_globals]

night_light={
"type": "float",
"value": 0.0
}
fd_cam_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
fd_wind={
"type": "vec4",
"value": Vector4(0.83, 0.55, 0.6, 0)
}
fd_sat={
"type": "float",
"value": 0.6
}
fd_bright={
"type": "float",
"value": 0.88
}
fd_dirt={
"type": "float",
"value": 0.55
}
fd_wet={
"type": "float",
"value": 0.0
}
